{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "frontend:build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "frontend:lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "frontend:typecheck": "tsc --noEmit",
    "update-api-schema": "wget -q http://127.0.0.1:8000/openapi.json -O openapi.json && prettier --write ./openapi.json",
    "create-api-types": "orval --config orval.config.ts && prettier --write ./src/lib/generated",
    "api": "pnpm run update-api-schema && pnpm run create-api-types",
    "prettier": "prettier . --check",
    "prettify": "prettier . --write",
    "prettier:write": "prettier . --write",
    "prettier:check": "prettier . --check"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.1.0",
    "@tanstack/react-query": "^5.76.1",
    "axios": "^1.9.0",
    "next": "^15.3.4",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "eslint-config-prettier": "^10.1.5",
    "orval": "^8.4.2",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "babel-plugin-react-compiler": "^1.0.0"
  }
}
